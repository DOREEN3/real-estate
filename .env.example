# ==============================================================================
# Real Estate Application Environment Configuration (.env.example)
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Application Environment: 'production' or 'development'
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=real_estate
DB_USER=your_db_user
DB_PASSWORD=your_db_secure_password

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# Generate a 64+ char secret: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=604800

# Generate a random one-time first-admin setup key; remove it after the first admin is created.
ADMIN_SETUP_KEY=

# CORS Allowed Origins: comma-separated exact HTTPS origins in production
# (e.g., https://app.yourdomain.com,https://admin.yourdomain.com)
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# Trusted reverse proxies (load balancer / Cloudflare IPs)
TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# Email / Notification Service Configuration (Reset Password, Enquiries, Alerts)
# Provider options: 'smtp', 'sendgrid', 'mailgun', 'native'
# ------------------------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Real Estate Portal"
PASSWORD_RESET_URL=https://app.yourdomain.com/reset-password
REGISTRATION_URL=https://app.yourdomain.com

# SMTP Settings (if MAIL_DRIVER=smtp)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_ENCRYPTION=tls

# SendGrid Settings (if MAIL_DRIVER=sendgrid)
SENDGRID_API_KEY=your_sendgrid_api_key

# Admin Notification Recipient (Receives copy of serious enquiries & property alerts)
ADMIN_NOTIFICATION_EMAIL=notifications@yourdomain.com
ADMIN_NOTIFICATION_PHONE=+254700000000

# ------------------------------------------------------------------------------
# SMS Gateway Configuration (Enquiry matching, property alerts, payment receipts)
# Provider options: 'africastalking', 'twilio', 'sandbox'
# ------------------------------------------------------------------------------
SMS_PROVIDER=sandbox
SMS_SENDER_ID=REALESTATE

# Africa's Talking Credentials (if SMS_PROVIDER=africastalking)
AFRICASTALKING_USERNAME=your_at_username
AFRICASTALKING_API_KEY=your_at_api_key

# Twilio Credentials (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ------------------------------------------------------------------------------
# WhatsApp Cloud API Configuration (Meta / Twilio)
# Provider options: 'meta_cloud', 'twilio', 'sandbox'
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=sandbox
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id

# ------------------------------------------------------------------------------
# Payment Recording & Automated Provider Activation Flags
# Launch with manual payment recording enabled and automated providers disabled
# until the client confirms and provides production API credentials.
# ------------------------------------------------------------------------------
MANUAL_PAYMENTS_ENABLED=true
MPESA_ENABLED=false
BANK_API_ENABLED=false

# ------------------------------------------------------------------------------
# M-Pesa Daraja API Configuration (Active only when MPESA_ENABLED=true)
# ------------------------------------------------------------------------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/payments/providers/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# ------------------------------------------------------------------------------
# Bank Automated Payment / Webhook Configuration (Equity, KCB, Co-op, Pesalink)
# ------------------------------------------------------------------------------
BANK_PROVIDER=pesalink
BANK_WEBHOOK_SECRET=your_bank_webhook_secret_key_for_hmac
BANK_CALLBACK_URL=https://yourdomain.com/api/v1/payments/providers/bank/callback
BANK_API_KEY=your_bank_api_key
BANK_ACCOUNT_NUMBER=0123456789012
BANK_NAME="National Bank / Equity / KCB"
